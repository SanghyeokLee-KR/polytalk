          <mxGeometry height="420" width="520" x="56" y="92" as="geometry" />
        </mxCell>
        <mxCell id="main" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBE9D9;strokeColor=#D05C17;fontColor=#8A4011;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;MainThread&lt;/b&gt;: &lt;font face=&quot;Courier New&quot;&gt;ServerSocket(:5000).accept()&lt;/font&gt;">
