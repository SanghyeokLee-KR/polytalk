<mxfile host="app.diagrams.net">
  <diagram name="2. 세션키 핸드셰이크" id="polytalk-handshake">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1040" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" vertex="1" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#1F2A37;" value="세션 키 핸드셰이크 (1-RTT)">
          <mxGeometry height="24" width="700" x="40" y="26" as="geometry" />
        </mxCell>
        <mxCell id="hc" parent="1" vertex="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#1565C0;fontColor=#15366B;fontStyle=1;fontSize=12;verticalAlign=middle;align=center;" value="Client">
          <mxGeometry height="40" width="130" x="180" y="82" as="geometry" />
        </mxCell>
        <mxCell id="hs" parent="1" vertex="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBE9D9;strokeColor=#D05C17;fontColor=#8A4011;fontStyle=1;fontSize=12;verticalAlign=middle;align=center;" value="Server">
          <mxGeometry height="40" width="130" x="710" y="82" as="geometry" />
        </mxCell>
        <mxCell id="llc" parent="1" edge="1" style="endArrow=none;dashed=1;html=1;strokeColor=#C9D2DA;strokeWidth=1.25;"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="122" as="sourcePoint" /><mxPoint x="245" y="664" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lls" parent="1" edge="1" style="endArrow=none;dashed=1;html=1;strokeColor=#C9D2DA;strokeWidth=1.25;"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="122" as="sourcePoint" /><mxPoint x="775" y="664" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m1" parent="1" edge="1" value="LOGIN (id, pw)" style="endArrow=block;html=1;rounded=0;strokeColor=#1565C0;strokeWidth=1.75;fontColor=#15366B;fontSize=11;"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="166" as="sourcePoint" /><mxPoint x="775" y="166" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m1r" parent="1" edge="1" value="LOGIN_SUCCESS" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#D05C17;strokeWidth=1.5;fontColor=#8A4011;fontSize=11;"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="202" as="sourcePoint" /><mxPoint x="245" y="202" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" parent="1" edge="1" value="CIPHER_SUITE_REQUEST  ·  algorithms, C_PUB" style="endArrow=block;html=1;rounded=0;strokeColor=#1565C0;strokeWidth=1.75;fontColor=#15366B;fontSize=11;"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="248" as="sourcePoint" /><mxPoint x="775" y="248" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ns" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F3ECFA;strokeColor=#6A1B9A;fontColor=#4A148C;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;서버 연산&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;ECDH(S_PRI, C_PUB)&lt;/font&gt; → shared&lt;br&gt;SEED 생성 · &lt;font face=&quot;Courier New&quot;&gt;E(SEED)=AES-GCM(shared)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;PBKDF2(SEED,1000)&lt;/font&gt; → session key">
          <mxGeometry height="96" width="320" x="560" y="284" as="geometry" />
        </mxCell>
        <mxCell id="m2r" parent="1" edge="1" value="CIPHER_SUITE_RESPONSE  ·  algorithm, S_PUB, E(SEED)" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#D05C17;strokeWidth=1.5;fontColor=#8A4011;fontSize=11;"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="418" as="sourcePoint" /><mxPoint x="245" y="418" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nc" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F3ECFA;strokeColor=#6A1B9A;fontColor=#4A148C;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;클라이언트 연산&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;ECDH(C_PRI, S_PUB)&lt;/font&gt; → shared (동일)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;SEED = decrypt(shared, E(SEED))&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;PBKDF2(SEED,1000)&lt;/font&gt; → session key (동일)">
          <mxGeometry height="96" width="320" x="180" y="454" as="geometry" />
        </mxCell>
        <mxCell id="res" parent="1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DFF3D8;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" value="양측이 동일한 세션 키 보유 — SEED·키는 전송되지 않고 공개키만 교환된다">
          <mxGeometry height="38" width="960" x="40" y="604" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
