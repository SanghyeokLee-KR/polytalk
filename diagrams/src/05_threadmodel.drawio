        <mxCell id="ce2" parent="1" edge="1" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=1.25;endArrow=block;exitX=0.7;exitY=1;entryX=0.7;entryY=0;fontColor=#15366B;fontSize=10;" source="sock" target="recv" value="수신"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="link" parent="1" edge="1" style="html=1;rounded=0;strokeColor=#1F2A37;strokeWidth=2;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#334155;fontSize=10;" source="srv" target="sock" value="TCP socket :5000"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#D6B656;fontColor=#5A4A00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" value="입력과 수신을 다른 스레드로 분리해, 블로킹 readLine()으로 메시지를 기다리는 중에도 사용자는 입력을 계속할 수 있다. 서버는 핸들러를 풀로 관리해 다수 접속을 동시에 처리한다.">
