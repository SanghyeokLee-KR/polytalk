        <mxCell id="h1" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#52606D;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;&lt;font color=&quot;#8A4011&quot;&gt;ClientHandler #1&lt;/font&gt;&lt;/b&gt; (thread)&lt;br&gt;&lt;font color=&quot;#6B7785&quot;&gt;readLine() 루프&lt;br&gt;→ ServerMessageRouter&lt;/font&gt;">
